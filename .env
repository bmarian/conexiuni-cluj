# Server
ENV=development
PORT=6698

# One SQLite per city, {slug}.db in each: its data, and its history
DB_DIR=../db
ARCHIVE_DIR=../archive
LOG_DIR=../logs
LOG_RETENTION_DAYS=5

# Tranzy (keys are per city, in keys.env; the quotas are per key)
TRANZY_BASE_URL=https://api.tranzy.ai/v1/opendata
TRANZY_RATE_LIMIT=200ms
TRANZY_VEHICLES_DAILY_QUOTA=4856
TRANZY_DEFAULT_DAILY_QUOTA=144

# Timetables: CTP's CSVs for Cluj, GTFS zips elsewhere, read again this often
TIMETABLE_REFRESH=24h
CTP_CSV_BASE_URL=https://ctpcj.ro/orare/csv
CTP_CJ_RATE_LIMIT=1s

# Vehicle polling while people watch
# Slot spec: HH:MM-HH:MM;NORMAL[;IDLE@THRESHOLD], comma-separated.
# Idle interval applies when subscribers < threshold.
VEHICLE_SCHEDULE='00:00-06:00;30s;60s@20, 06:00-07:00;20s, 07:00-09:00;10s, 09:00-16:00;20s, 16:00-18:30;10s, 18:30-22:00;20s, 22:00-24:00;30s;60s@20'
VEHICLE_SCHEDULE_WEEKEND='00:00-06:00;30s;60s@20, 06:00-22:00;20s, 22:00-24:00;30s;60s@20'
VEHICLE_MIN_INTERVAL=5s
VEHICLE_MAX_INTERVAL=60s

# Vehicle samples for learning while nobody watches; VEHICLE_LEARNING_ENABLED_{CITY} overrides it for one city
VEHICLE_LEARNING_ENABLED=true
VEHICLE_LEARNING_ENABLED_BOTOSANI=false
VEHICLE_LEARNING_ENABLED_SIBIU=false
VEHICLE_LEARNING_DAILY_QUOTA_MAX=5000

# Android app links
ANDROID_PACKAGE=online.bmarian.bus
ANDROID_CERT_SHA256=62:27:58:F3:DC:81:07:9C:86:45:50:12:9D:28:34:F7:9A:01:2B:4D:CE:A7:D3:D3:A3:5A:2D:74:9D:0D:4C:76
